# SovereignBI — Variables d'environnement
# Copier vers .env et remplir les valeurs avant de lancer l'application.
# Générer les secrets : openssl rand -hex 32

# ── Clés API (RBAC) ───────────────────────────────────────────────────────────
SOVEREIGN_VIEWER_KEY=change_me_viewer
SOVEREIGN_EDITOR_KEY=change_me_editor
SOVEREIGN_ADMIN_KEY=change_me_admin

# ── Certificat de précision ───────────────────────────────────────────────────
# Clé HMAC-SHA256 pour signer les certificats de précision
SOVEREIGN_CERT_SECRET=change_me_cert_secret

# ── LLM local (Ollama) ────────────────────────────────────────────────────────
LLM_MODEL=qwen2.5-coder:32b
OLLAMA_URL=http://ollama:11434

# ── Embeddings ────────────────────────────────────────────────────────────────
# "tfidf" (sans réseau, tests) ou "bge-m3" (production)
SOVEREIGN_EMBEDDER=bge-m3

# ── Sécurité réseau ───────────────────────────────────────────────────────────
# Origines CORS autorisées (séparées par virgule)
SOVEREIGN_CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# Limite de requêtes par IP et par minute (défaut : 60)
SOVEREIGN_RATE_LIMIT_RPM=60

# ── Connecteurs optionnels (ne remplir que si utilisés) ───────────────────────
# PostgreSQL
# SOVEREIGN_PG_DSN=postgresql://user:password@host:5432/dbname

# MySQL
# SOVEREIGN_MYSQL_HOST=localhost
# SOVEREIGN_MYSQL_USER=readonly
# SOVEREIGN_MYSQL_PASSWORD=change_me
# SOVEREIGN_MYSQL_DB=mydb

# Snowflake (nécessite snowflake-connector-python)
# SNOWFLAKE_ACCOUNT=myaccount.us-east-1
# SNOWFLAKE_USER=readonly
# SNOWFLAKE_PASSWORD=change_me
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# BigQuery (nécessite google-cloud-bigquery + credentials JSON)
# GOOGLE_APPLICATION_CREDENTIALS=/srv/secrets/sa.json

# MongoDB (nécessite pymongo)
# MONGO_URI=mongodb://localhost:27017

# Email/password auth (ADMIN_PASSWORD doit comporter au moins 12 caractères)
ADMIN_EMAIL=admin@sovereignbi.local
ADMIN_PASSWORD=CHANGE_THIS_NOW_minimum12chars
SESSION_TTL_HOURS=8
SOVEREIGN_AUTH_DB=/srv/uploads/auth.db

# Clé de signature des tokens embed — générer : openssl rand -hex 32
SOVEREIGN_EMBED_SECRET=

# UN Comtrade Plus API (https://comtradeplus.un.org)
# Clé gratuite — 500 appels/jour. Licence : usage institutionnel, citer la source.
# Sans cette clé, /api/v1/trade-flows retourne des données illustratives.
# COMTRADE_API_KEY=votre_cle_ici

# --- Abonnements courriel (P-067) ---
# Sans SMTP_HOST, les messages sont écrits dans data/outbox/*.eml (aucun envoi réel).
# SMTP_HOST=
# SMTP_PORT=587            # 587 = STARTTLS obligatoire ; 465 = TLS direct
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=bulletins@exemple.dj
# SOVEREIGN_PUBLIC_URL=https://bi.exemple.dj      # HTTPS requis pour le lien de désabonnement
# SOVEREIGN_SUBSCRIPTION_DOMAINS=instad.dj        # optionnel : limite les destinataires à ces domaines
# SOVEREIGN_SUBSCRIPTIONS=1                       # 0 = désactive l'envoi planifié

# --- Mode strict de l'IA (P-070) ---
# Aucune donnée des tables n'est envoyée au modèle : ni lignes d'exemple, ni résultats, ni extraits de documents,
# ni insights de tuiles, ni réponses précédentes du chat. Seuls la question, les noms de tables/colonnes et le
# modèle sémantique partent. Valeurs : 1 = actif ; 0 = désactivé ; vide/absent = AUTOMATIQUE
# (actif dès que LLM_PROVIDER n'est pas « ollama », y compris une faute de frappe ; inactif avec le modèle local).
# Avec un LLM externe, ne mettre 0 que sur décision écrite du client : un avertissement est alors émis au démarrage.
# SOVEREIGN_AI_STRICT=

# --- Fournisseur d'IA ---
# LLM_PROVIDER=ollama            # ollama (local, défaut) ou kimi = n'importe quelle API « chat/completions » externe
# KIMI_BASE_URL=https://         # obligatoire si LLM_PROVIDER=kimi, HTTPS imposé, jamais codé en dur
# KIMI_API_KEY=                  # clé du fournisseur : ici seulement, jamais dans le dépôt
# KIMI_MODEL=                    # nom du modèle chez le fournisseur
# KIMI_TIMEOUT=60                # secondes
# KIMI_DAILY_BUDGET_USD=5.0      # plafond de dépense quotidien
# Avec un fournisseur externe, le mode strict est automatique (voir SOVEREIGN_AI_STRICT plus bas).

# --- Sécurité par ligne, certification, incidents (chemins facultatifs, défaut dans data/) ---
# SOVEREIGN_ROW_POLICIES=data/row_policies.yaml       # absent = pas de règle ; défini mais introuvable = REFUS (échec fermé)
# SOVEREIGN_CERTIFICATIONS_PATH=data/certified_datasets.json
# SOVEREIGN_INCIDENTS_PATH=data/incidents.jsonl
# SOVEREIGN_SUBSCRIPTIONS_PATH=data/subscriptions.json
