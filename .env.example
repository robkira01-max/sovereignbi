# SovereignBI — Variables d'environnement
# Copier vers .env et remplir les valeurs avant de lancer l'application.
# Générer les secrets : openssl rand -hex 32

# ── Clés API (RBAC) ───────────────────────────────────────────────────────────
SOVEREIGN_VIEWER_KEY=change_me_viewer
SOVEREIGN_EDITOR_KEY=change_me_editor
SOVEREIGN_ADMIN_KEY=change_me_admin

# ── Certificat de précision ───────────────────────────────────────────────────
# Clé HMAC-SHA256 pour signer les certificats de précision
SOVEREIGN_CERT_SECRET=change_me_cert_secret

# ── LLM local (Ollama) ────────────────────────────────────────────────────────
LLM_MODEL=qwen2.5-coder:32b
OLLAMA_URL=http://ollama:11434

# ── Embeddings ────────────────────────────────────────────────────────────────
# "tfidf" (sans réseau, tests) ou "bge-m3" (production)
SOVEREIGN_EMBEDDER=bge-m3

# ── Sécurité réseau ───────────────────────────────────────────────────────────
# Origines CORS autorisées (séparées par virgule)
SOVEREIGN_CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# Limite de requêtes par IP et par minute (défaut : 60)
SOVEREIGN_RATE_LIMIT_RPM=60

# ── Connecteurs optionnels (ne remplir que si utilisés) ───────────────────────
# PostgreSQL
# SOVEREIGN_PG_DSN=postgresql://user:password@host:5432/dbname

# MySQL
# SOVEREIGN_MYSQL_HOST=localhost
# SOVEREIGN_MYSQL_USER=readonly
# SOVEREIGN_MYSQL_PASSWORD=change_me
# SOVEREIGN_MYSQL_DB=mydb

# Snowflake (nécessite snowflake-connector-python)
# SNOWFLAKE_ACCOUNT=myaccount.us-east-1
# SNOWFLAKE_USER=readonly
# SNOWFLAKE_PASSWORD=change_me
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# BigQuery (nécessite google-cloud-bigquery + credentials JSON)
# GOOGLE_APPLICATION_CREDENTIALS=/srv/secrets/sa.json

# MongoDB (nécessite pymongo)
# MONGO_URI=mongodb://localhost:27017

# Email/password auth
ADMIN_EMAIL=admin@sovereignbi.local
ADMIN_PASSWORD=changeme
SESSION_TTL_HOURS=24
SOVEREIGN_AUTH_DB=/srv/uploads/auth.db
