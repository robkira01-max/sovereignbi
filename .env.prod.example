# SovereignBI — Variables d'environnement PRODUCTION
# Copier vers .env et remplir toutes les valeurs avant docker compose up.
# Ne jamais committer .env dans git.
#
# Générer les clés :
#   openssl rand -hex 32   (pour SOVEREIGN_*_KEY et SOVEREIGN_CERT_SECRET)

# ── Domaine et TLS (Caddy) ────────────────────────────────────────────────────
DOMAIN=sovereignbi.votre-domaine.example.com
ACME_EMAIL=admin@votre-domaine.example.com

# ── LLM — Groq API (gratuit, 6 000 req/min, modèle Qwen 27b) ─────────────────
# Inscription : https://console.groq.com → Create API Key (gratuit)
LLM_PROVIDER=kimi
KIMI_BASE_URL=https://api.groq.com/openai/v1
KIMI_API_KEY=gsk_VOTRE_CLE_GROQ
KIMI_MODEL=qwen/qwen3.8-27b
KIMI_TIMEOUT=60

# ── Clés RBAC (accès API) ─────────────────────────────────────────────────────
# Chaque clé donne un niveau d'accès différent.
# Viewer : lecture seule (requêtes, dashboards)
# Editor : + upload fichiers, création templates
# Admin  : + gestion connecteurs, catalogue global
SOVEREIGN_VIEWER_KEY=CHANGEME_viewer_32chars_random
SOVEREIGN_EDITOR_KEY=CHANGEME_editor_32chars_random
SOVEREIGN_ADMIN_KEY=CHANGEME_admin_32chars_random

# ── Certificat de précision ───────────────────────────────────────────────────
SOVEREIGN_CERT_SECRET=CHANGEME_cert_secret_32chars

# ── Chiffrement coffre credentials ───────────────────────────────────────────
SOVEREIGN_VAULT_KEY=CHANGEME_vault_key_32chars_random

# ── Embeddings ────────────────────────────────────────────────────────────────
# tfidf = sans réseau, léger, suffisant pour la plupart des cas
# bge-m3 = meilleure qualité sémantique (télécharge ~1 GB au premier démarrage)
SOVEREIGN_EMBEDDER=tfidf

# ── CORS ─────────────────────────────────────────────────────────────────────
SOVEREIGN_CORS_ORIGINS=https://sovereignbi.votre-domaine.example.com

# ── Rate limit ────────────────────────────────────────────────────────────────
SOVEREIGN_RATE_LIMIT_RPM=60
