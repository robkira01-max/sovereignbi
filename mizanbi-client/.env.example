# MizanBI — variables d'environnement
# Copier en .env pour un usage local. Ne jamais commiter de .env avec une clé.
# Laissez VITE_API_BASE vide pour utiliser uniquement les données de démonstration.

VITE_API_BASE=

# Exemple (API SovereignBI du brief, à renseigner uniquement en déploiement) :
# VITE_API_BASE=https://sovereignbi-api.147-5-126-188.sslip.io

# Analytics (optionnel — laisser vide pour désactiver, aucun traceur sans cette variable)
# Compatible Plausible et Umami auto-hébergés.
# VITE_ANALYTICS_URL=https://analytics.example.com/script.js
# VITE_ANALYTICS_SITE_ID=votre-domaine.com   # data-domain (Plausible) / data-website-id (Umami)

# URL publique du site (https://...) : rend absolues les URL og:image / og:url (aperçus LinkedIn, Facebook, X).
# VITE_SITE_URL=https://mizanbi.example.org

# Les clés API ne sont JAMAIS mises ici, ni livrées au navigateur : l'authentification se fait
# uniquement par POST /auth/login (jeton de session en sessionStorage, mizan_token).
# La mesure d'audience ci-dessus ne se charge qu'après consentement de l'utilisateur.
